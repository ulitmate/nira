{
  "$schema": "Nira design tokens — the single source of truth. Edit here, then run `node design/scripts/build-tokens.mjs`.",
  "version": "2.0.0",
  "name": "Nira Glass",

  "color": {
    "light": {
      "bg":              "#F5F5F7",
      "surface":         "#FFFFFF",
      "surface-raised":  "#FFFFFF",
      "surface-sunken":  "#EEEEF2",
      "border":          "#E3E3E8",
      "border-strong":   "#C7C7CC",

      "text":            "#1D1D1F",
      "text-muted":      "#636368",
      "text-subtle":     "#6E6E73",
      "text-inverse":    "#FFFFFF",

      "primary":         "#1D1D1F",
      "primary-hover":   "#3A3A3C",
      "on-primary":      "#FFFFFF",

      "accent":          "#E11D48",
      "accent-hover":    "#BE123C",
      "accent-soft":     "#FFE4EA",
      "on-accent":       "#FFFFFF",
      "brand-from":      "#E11D48",
      "brand-to":        "#7C3AED",
      "on-brand":        "#FFFFFF",

      "focus":           "#0071E3",

      "success":         "#1F7A36",
      "success-soft":    "#E3F5E8",
      "warning":         "#A64B00",
      "warning-soft":    "#FFF1E0",
      "danger":          "#D70015",
      "danger-soft":     "#FDE7E9",
      "info":            "#0066CC",
      "info-soft":       "#E5F1FD",

      "phase-menstrual":       "#FF375F",
      "phase-menstrual-soft":  "#FFE4EA",
      "phase-menstrual-ink":   "#B80F37",
      "phase-follicular":      "#00B8A9",
      "phase-follicular-soft": "#DDF6F3",
      "phase-follicular-ink":  "#00695F",
      "phase-fertile":         "#FF9F0A",
      "phase-fertile-soft":    "#FFF0D9",
      "phase-fertile-ink":     "#8F4F00",
      "phase-luteal":          "#8E5CF7",
      "phase-luteal-soft":     "#EFE8FF",
      "phase-luteal-ink":      "#5B2BC9",

      "ai":              "#5B2BC9",
      "ai-soft":         "#EFE8FF",

      "glass":           "rgba(255, 255, 255, 0.58)",
      "glass-strong":    "rgba(255, 255, 255, 0.80)",
      "glass-stroke":    "rgba(255, 255, 255, 0.85)",
      "glass-edge":      "rgba(0, 0, 0, 0.06)",
      "glass-sheen":     "rgba(255, 255, 255, 0.95)",
      "glass-fill":      "rgba(118, 118, 128, 0.10)",
      "aura-strength":   "0.38",

      "scrim":           "rgba(0, 0, 0, 0.30)"
    },
    "dark": {
      "bg":              "#050507",
      "surface":         "#1C1C1E",
      "surface-raised":  "#2C2C2E",
      "surface-sunken":  "#2A2A2E",
      "border":          "#2C2C30",
      "border-strong":   "#48484A",

      "text":            "#F5F5F7",
      "text-muted":      "#A1A1A6",
      "text-subtle":     "#8E8E93",
      "text-inverse":    "#1D1D1F",

      "primary":         "#F5F5F7",
      "primary-hover":   "#FFFFFF",
      "on-primary":      "#000000",

      "accent":          "#FF4D6D",
      "accent-hover":    "#FF6B85",
      "accent-soft":     "#3D0F1A",
      "on-accent":       "#000000",
      "brand-from":      "#E11D48",
      "brand-to":        "#7C3AED",
      "on-brand":        "#FFFFFF",

      "focus":           "#409CFF",

      "success":         "#30D158",
      "success-soft":    "#0F2E18",
      "warning":         "#FFB340",
      "warning-soft":    "#3A2808",
      "danger":          "#FF6961",
      "danger-soft":     "#3D1412",
      "info":            "#64B5FF",
      "info-soft":       "#0D2540",

      "phase-menstrual":       "#FF4D6D",
      "phase-menstrual-soft":  "#3D0F1A",
      "phase-menstrual-ink":   "#FF9AAE",
      "phase-follicular":      "#30D5C8",
      "phase-follicular-soft": "#08302D",
      "phase-follicular-ink":  "#7EEBE2",
      "phase-fertile":         "#FFB340",
      "phase-fertile-soft":    "#3A2808",
      "phase-fertile-ink":     "#FFD28A",
      "phase-luteal":          "#A78BFA",
      "phase-luteal-soft":     "#2A1D52",
      "phase-luteal-ink":      "#CDBEFF",

      "ai":              "#C4B0FF",
      "ai-soft":         "#241A45",

      "glass":           "rgba(28, 28, 32, 0.52)",
      "glass-strong":    "rgba(38, 38, 42, 0.78)",
      "glass-stroke":    "rgba(255, 255, 255, 0.10)",
      "glass-edge":      "rgba(0, 0, 0, 0.50)",
      "glass-sheen":     "rgba(255, 255, 255, 0.16)",
      "glass-fill":      "rgba(118, 118, 128, 0.20)",
      "aura-strength":   "0.42",

      "scrim":           "rgba(0, 0, 0, 0.60)"
    }
  },

  "font": {
    "stack": {
      "display": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Inter Display\", \"Inter\", system-ui, sans-serif",
      "ui":      "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Inter\", system-ui, \"Segoe UI\", Roboto, sans-serif",
      "rounded": "ui-rounded, \"SF Pro Rounded\", -apple-system, \"Inter Display\", \"Inter\", system-ui, sans-serif",
      "mono":    "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, monospace"
    },
    "native": {
      "ios":     { "display": "System", "ui": "System", "rounded": "System (design: rounded)", "mono": "Menlo" },
      "android": { "display": "Inter-Display", "ui": "Inter", "rounded": "Inter-Display", "mono": "monospace" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "heavy": 800 }
  },

  "type": {
    "hero":        { "family": "rounded", "size": 96, "line": 96, "weight": 700, "tracking": -0.045 },
    "display":     { "family": "display", "size": 48, "line": 52, "weight": 700, "tracking": -0.035 },
    "large-title": { "family": "display", "size": 34, "line": 41, "weight": 700, "tracking": -0.025 },
    "title-1":     { "family": "display", "size": 28, "line": 34, "weight": 700, "tracking": -0.02 },
    "title-2":     { "family": "display", "size": 22, "line": 28, "weight": 700, "tracking": -0.015 },
    "title-3":     { "family": "ui",      "size": 20, "line": 25, "weight": 600, "tracking": -0.01 },
    "headline":    { "family": "ui",      "size": 17, "line": 22, "weight": 600, "tracking": -0.01 },
    "body":        { "family": "ui",      "size": 17, "line": 24, "weight": 400, "tracking": -0.01 },
    "callout":     { "family": "ui",      "size": 16, "line": 21, "weight": 400, "tracking": -0.005 },
    "subhead":     { "family": "ui",      "size": 15, "line": 20, "weight": 400, "tracking": -0.005 },
    "footnote":    { "family": "ui",      "size": 13, "line": 18, "weight": 400, "tracking": 0 },
    "caption":     { "family": "ui",      "size": 12, "line": 16, "weight": 500, "tracking": 0 },
    "overline":    { "family": "ui",      "size": 12, "line": 16, "weight": 600, "tracking": 0.06 }
  },

  "space": {
    "0": 0, "px": 1, "0-5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20,
    "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80
  },

  "radius": { "xs": 8, "sm": 12, "md": 18, "lg": 28, "xl": 36, "pill": 999 },

  "blur": { "glass": 28, "glass-strong": 40, "aura": 90 },

  "elevation": {
    "light": {
      "1": "0 1px 1px rgba(0,0,0,0.03), 0 8px 24px -12px rgba(30,20,60,0.18)",
      "2": "0 2px 4px rgba(0,0,0,0.04), 0 18px 40px -16px rgba(30,20,60,0.28)",
      "3": "0 4px 8px rgba(0,0,0,0.05), 0 32px 80px -24px rgba(30,20,60,0.40)"
    },
    "dark": {
      "1": "0 1px 1px rgba(0,0,0,0.40), 0 10px 30px -12px rgba(0,0,0,0.70)",
      "2": "0 2px 4px rgba(0,0,0,0.50), 0 20px 48px -16px rgba(0,0,0,0.80)",
      "3": "0 4px 8px rgba(0,0,0,0.60), 0 36px 90px -24px rgba(0,0,0,0.90)"
    }
  },

  "motion": {
    "duration": { "instant": 90, "fast": 160, "base": 280, "slow": 520, "ambient": 28000 },
    "easing": {
      "standard":   "cubic-bezier(0.2, 0, 0, 1)",
      "spring":     "cubic-bezier(0.34, 1.4, 0.64, 1)",
      "exit":       "cubic-bezier(0.4, 0, 1, 1)"
    },
    "spring-native": { "damping": 18, "stiffness": 220, "mass": 1 }
  },

  "size": {
    "touch-min": 44,
    "touch-comfortable": 48,
    "icon-sm": 16,
    "icon": 20,
    "icon-lg": 24,
    "sidebar": 264,
    "content-max": 1200,
    "tabbar-height": 64
  },

  "breakpoint": { "sm": 640, "md": 900, "lg": 1200, "xl": 1440 },

  "z": { "aura": -1, "base": 0, "sticky": 10, "nav": 20, "overlay": 40, "modal": 50, "toast": 60 },

  "contrast-checks": [
    ["text", "bg", 4.5], ["text", "surface", 4.5],
    ["text-muted", "bg", 4.5], ["text-muted", "surface", 4.5], ["text-muted", "surface-sunken", 4.5],
    ["text-subtle", "surface", 4.5],
    ["on-primary", "primary", 4.5], ["on-accent", "accent", 4.5],
    ["on-brand", "brand-from", 4.5], ["on-brand", "brand-to", 4.5],
    ["accent", "surface", 4.5], ["danger", "surface", 4.5], ["success", "surface", 4.5],
    ["warning", "surface", 4.5], ["info", "surface", 4.5],
    ["phase-menstrual-ink", "phase-menstrual-soft", 4.5],
    ["phase-follicular-ink", "phase-follicular-soft", 4.5],
    ["phase-fertile-ink", "phase-fertile-soft", 4.5],
    ["phase-luteal-ink", "phase-luteal-soft", 4.5],
    ["ai", "ai-soft", 4.5],
    ["focus", "bg", 3], ["border-strong", "surface", 1.5]
  ]
}
